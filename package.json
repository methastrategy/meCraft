{
  "name": "mecraft-monorepo",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:launcher": "npm run dev --workspace=@mecraft/launcher",
    "dev:pdf": "npm run dev --workspace=@mecraft/mepdf",
    "dev:photo": "npm run dev --workspace=@mecraft/mephoto",
    "dev:ide": "npm run dev --workspace=@mecraft/meide",
    "desktop:launcher": "npm run desktop:dev --workspace=@mecraft/launcher",
    "desktop:pdf": "npm run desktop:dev --workspace=@mecraft/mepdf",
    "desktop:photo": "npm run desktop:dev --workspace=@mecraft/mephoto",
    "desktop:ide": "npm run desktop:dev --workspace=@mecraft/meide",
    "desktop:medoc": "npm run desktop:dev --workspace=@mecraft/medoc",
    "desktop:medrop": "npm run desktop:dev --workspace=@mecraft/medrop",
    "desktop:3d": "npm run desktop:dev --workspace=@mecraft/me3d",
    "desktop:audio": "npm run desktop:dev --workspace=@mecraft/meaudio",
    "desktop:deck": "npm run desktop:dev --workspace=@mecraft/medeck",
    "desktop:design": "npm run desktop:dev --workspace=@mecraft/medesign",
    "desktop:film": "npm run desktop:dev --workspace=@mecraft/mefilm",
    "desktop:light": "npm run desktop:dev --workspace=@mecraft/melight",
    "desktop:motion": "npm run desktop:dev --workspace=@mecraft/memotion",
    "desktop:sheet": "npm run desktop:dev --workspace=@mecraft/mesheet",
    "desktop:vector": "npm run desktop:dev --workspace=@mecraft/mevector",
    "build": "node scripts/build-web.js",
    "build:web": "node scripts/build-web.js",
    "deploy:website": "node scripts/deploy-website.js",
    "build:all": "npm run build --workspaces --if-present",
    "generate:bitmaps": "node scripts/generate-installer-bitmaps.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:docs": "node scripts/verify-docs.js",
    "test": "vitest run",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "jszip": "^3.10.1",
    "lucide": "^1.59.0",
    "pdf-lib": "^1.17.1",
    "pdf-lib-plus-encrypt": "^1.1.0",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "@types/node": "^26.6.5",
    "typescript": "^5.7.3",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
