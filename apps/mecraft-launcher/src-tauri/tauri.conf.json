{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "meCraft",
  "version": "3.2.0",
  "identifier": "com.mecraft.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "meCraft — Creative & Document Hub",
        "width": 1240,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "hooks.nsh",
        "startMenuFolder": "meCraft",
        "installMode": "both",
        "languages": ["English", "Thai"],
        "displayLanguageSelector": false,
        "sidebarImage": "icons/installer-sidebar.bmp",
        "headerImage": "icons/installer-header.bmp"
      }
    }
  }
}
