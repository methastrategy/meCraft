<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="LauncherInstallRegistry" Guid="*" Win64="yes">
        <RegistryKey Root="HKLM" Key="Software\meCraft\[ProductName]">
          <RegistryValue Name="InstallLocation" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
          <RegistryValue Name="InstallerType" Type="string" Value="msi" />
        </RegistryKey>
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
