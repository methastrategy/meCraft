{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "paths": {
      "@mecraft/core-bridge": ["../../packages/core-bridge/src/index.ts"],
      "@mecraft/core-bridge/*": ["../../packages/core-bridge/src/*"],
      "@mecraft/ui-tokens": ["../../packages/ui-tokens/src/index.ts"],
      "@mecraft/ui-tokens/*": ["../../packages/ui-tokens/*"],
      "@mecraft/photo-core": ["../../packages/photo-core/src/index.ts"],
      "@mecraft/photo-core/*": ["../../packages/photo-core/src/*"],
      "@mecraft/studio-shell": ["../../packages/studio-shell/src/index.ts"],
      "@mecraft/studio-shell/*": ["../../packages/studio-shell/src/*"],
      "@mecraft/mevector": ["../../apps/mevector/src/index.ts"],
      "@mecraft/me3d": ["../../apps/me3d/src/index.ts"],
      "@mecraft/meaudio": ["../../apps/meaudio/src/index.ts"],
      "@mecraft/medeck": ["../../apps/medeck/src/index.ts"],
      "@mecraft/medesign": ["../../apps/medesign/src/index.ts"],
      "@mecraft/mefilm": ["../../apps/mefilm/src/index.ts"],
      "@mecraft/melight": ["../../apps/melight/src/index.ts"],
      "@mecraft/memotion": ["../../apps/memotion/src/index.ts"],
      "@mecraft/mesheet": ["../../apps/mesheet/src/index.ts"],
      "@mecraft/medocs": ["../../apps/medocs/src/index.ts"]
    }
  },
  "include": ["src", "tests"]
}
