{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "meAudio Studio",
  "version": "1.0.0",
  "identifier": "com.mecraft.meaudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5182",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "meAudio Studio — Multi-Track Digital Audio Workstation & Noise Reducer",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "startMenuFolder": "meAudio Studio",
        "installMode": "both"
      }
    }
  }
}