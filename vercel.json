{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-web.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/mepdf", "destination": "/mepdf/", "permanent": true },
    { "source": "/mephoto", "destination": "/mephoto/", "permanent": true },
    { "source": "/medoc", "destination": "/medoc/", "permanent": true },
    { "source": "/medrop", "destination": "/medrop/", "permanent": true },
    { "source": "/mevector", "destination": "/mevector/", "permanent": true },
    { "source": "/me3d", "destination": "/me3d/", "permanent": true },
    { "source": "/meaudio", "destination": "/meaudio/", "permanent": true },
    { "source": "/medeck", "destination": "/medeck/", "permanent": true },
    { "source": "/medesign", "destination": "/medesign/", "permanent": true },
    { "source": "/mefilm", "destination": "/mefilm/", "permanent": true },
    { "source": "/melight", "destination": "/melight/", "permanent": true },
    { "source": "/memotion", "destination": "/memotion/", "permanent": true },
    { "source": "/mesheet", "destination": "/mesheet/", "permanent": true },
    { "source": "/mecad", "destination": "/mecad/", "permanent": true },
    { "source": "/metexture", "destination": "/metexture/", "permanent": true },
    { "source": "/mematerial", "destination": "/mematerial/", "permanent": true },
    { "source": "/meani", "destination": "/meani/", "permanent": true },
    { "source": "/merea", "destination": "/merea/", "permanent": true },
    { "source": "/downloads/meCraft-Setup.exe", "destination": "/downloads/", "permanent": false },
    { "source": "/downloads", "destination": "/downloads/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/auth", "destination": "/index.html" },
    { "source": "/auth/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/catalog/v1.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/desktop-auth(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
