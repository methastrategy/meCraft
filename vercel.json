{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-web.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/mepdf", "destination": "/mepdf/", "permanent": true },
    { "source": "/mephoto", "destination": "/mephoto/", "permanent": true },
    { "source": "/downloads", "destination": "/downloads/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
